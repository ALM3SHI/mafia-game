# Mafia AI Backend — Environment Configuration
# Copy this file to `.env` and adjust for your environment.
# All values have sensible defaults; override only what you need.

# ─── Server binding ────────────────────────────────────────────────
# Local dev:   127.0.0.1  (loopback only)
# LAN host:    0.0.0.0    (accept connections from other machines)
# Cloud:       0.0.0.0    (behind reverse proxy / load balancer)
MAFIA_HOST=0.0.0.0
MAFIA_PORT=8000

# ─── Optional API key (Bearer token) ───────────────────────────────
# Empty = no auth. Set a long random string when exposed to the internet.
MAFIA_API_KEY=

# ─── Ollama (LLM) ──────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=aya
OLLAMA_NUM_PREDICT=80
OLLAMA_TEMPERATURE=0.6

# ─── Whisper (STT) ─────────────────────────────────────────────────
# Models: tiny | base | small | medium | large-v3
# Devices: cpu | cuda
# Compute: int8 (CPU) | float16 (GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ar

# ─── Ultimate TTS Studio (Chatterbox Multilingual) ─────────────────
TTS_BASE_URL=http://127.0.0.1:7860/
TTS_ENGINE=Chatterbox Multilingual
TTS_LANGUAGE=ar
TTS_FORMAT=wav

# Generation tuning. Quality > speed on dev box.
TTS_TEMPERATURE=0.7
TTS_EXAGGERATION=0.55
TTS_CFG_WEIGHT=0.5
TTS_REPETITION_PENALTY=2.0
TTS_MIN_P=0.05
TTS_TOP_P=1.0
TTS_CHUNK_SIZE=120
TTS_SEED=0

# Voice cloning reference audio (relative to MAFIA_DATA_DIR or absolute).
# Empty = no cloning, default Chatterbox voice.
TTS_DEFAULT_REF_AUDIO=voice_sample.wav

# ─── Data paths (mount as volumes in cloud) ────────────────────────
# All persistent state lives under MAFIA_DATA_DIR for easy volume-mount.
MAFIA_DATA_DIR=./data
MAFIA_CACHE_DIR=./data/tts_cache
MAFIA_CLONES_DIR=./data/clones
