# Web client (Next.js) — copy to .env.local
# WebSocket URL of the FastAPI voice backend (game_backend/main.py)
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/ws/audio
# Must match MAFIA_API_KEY in game_backend/.env (leave empty if auth is off).
# Note: anything NEXT_PUBLIC_ is visible to the browser — use a LAN-only key.
NEXT_PUBLIC_VOICE_API_KEY=
