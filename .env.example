# ── Web client (Next.js) — copy to .env.local ─────────────────────────────

# Online game server (server/index.ts). Leave empty to use ws://<this host>:3002,
# which works on your LAN out of the box. Set it when the server runs elsewhere,
# e.g. wss://mafia-server.onrender.com
NEXT_PUBLIC_GAME_SERVER_URL=

# Optional AI voice backend (game_backend/main.py) — local games only.
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/ws/audio
# Must match MAFIA_API_KEY in game_backend/.env (empty if auth is off).
NEXT_PUBLIC_VOICE_API_KEY=

# ── Game server ────────────────────────────────────────────────────────────
# PORT=3002
# MAX_ROOMS=500
